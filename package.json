{
  "name": "personal-portofolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run content:build",
    "dev": "vite",
    "build": "npm run content:build:production && npm run fonts:generate && tsc -b && vite build",
    "fonts:generate": "tsx scripts/generate-fonts.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:build:production": "tsx scripts/build-content.ts --production",
    "content:validate": "tsx scripts/build-content.ts --check",
    "content:validate:release": "tsx scripts/build-content.ts --check --release",
    "test:content": "node --import tsx --test scripts/content/*.test.ts src/lib/*.test.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "ttf2woff2": "^8.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "ttf2woff2@8.0.1": true
  }
}
